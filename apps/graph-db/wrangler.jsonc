{
  "name": "quran-graph-db",
  "main": "./src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRAPH",
        "class_name": "GraphDO"
      }
